#!/bin/bash

set -uo pipefail

umask 077
TTY="/dev/$(ps -p $$ -o tty=)"

################################################################
# Helper functions

function die() { echo "[1;31merror:[m $*" >&2; exit 1; }
function status() { echo "${had_status+$'\n'}[1;33m$*[m"; had_status=1; }
function flush_stdin() { while read -r -t 0.01 empty_stdin < "$TTY"; do true; done; }
function ask() {
	local response
	while true; do
		flush_stdin
		read -r -p "$* (Y/n) " response < "$TTY" || die "Error in read"
		case "${response,,}" in
			'') return 0 ;;
			y|yes) return 0 ;;
			n|no) return 1 ;;
			*) continue ;;
		esac
	done
}
# $1 = src, $2 = dest, $3 = owner, $4 = mode
function install_file() {
	cp    "$1" "$2" || die "Could not copy '$1' to '$2'"
	chown "$3" "$2" || die "Could not chown '$2'"
	chmod "$4" "$2" || die "Could not chmod '$2'"
}

################################################################
# Ensure that all required tools are installed

REQUIRED_TOOLS=(jq git tmux rdiff-backup java openssl)
AUR_HELPERS=(yay paru pikaur trizen)

REQUIRED_JAVA_VERSION=25

function java_major_version() {
	java -version 2>&1 | grep -oP 'version "\K\d+' | head -n1
}

function missing_tools() {
	local i
	for i in "${REQUIRED_TOOLS[@]}"; do
		type "$i" &>/dev/null || { echo "$i"; continue; }
		if [[ "$i" == java && "$(java_major_version)" -lt "$REQUIRED_JAVA_VERSION" ]]; then
			echo "$i"
		fi
	done
}

# Prints the distribution family: arch, debian, fedora, suse or nothing if unknown
function os_family() {
	local ids
	ids=" $(. /etc/os-release 2>/dev/null && echo "${ID-} ${ID_LIKE-}") "
	case "$ids" in
		*" arch "*) echo arch ;;
		*" debian "*|*" ubuntu "*) echo debian ;;
		*" fedora "*|*" rhel "*) echo fedora ;;
		*" suse "*|*" opensuse "*) echo suse ;;
	esac
}

# Java packages follow https://docs.papermc.io/misc/java-install/ (Amazon Corretto, no headless variants).
# The guide has no instructions for Arch, so the official OpenJDK package is used there.
# $1 = os family, $2 = tool
function package_name() {
	case "$2" in
		java)
			case "$1" in
				arch) echo "jre$REQUIRED_JAVA_VERSION-openjdk" ;;
				debian) echo "java-$REQUIRED_JAVA_VERSION-amazon-corretto-jdk libxi6 libxtst6 libxrender1" ;;
				fedora|suse) echo "java-$REQUIRED_JAVA_VERSION-amazon-corretto-devel" ;;
			esac ;;
		*) echo "$2" ;;
	esac
}

# $1 = os family
function setup_corretto_repository() {
	case "$1" in
		debian)
			apt-get update < "$TTY" \
				&& apt-get install -y ca-certificates apt-transport-https gnupg wget < "$TTY" \
				|| die "Could not install prerequisites for the Corretto repository"
			wget -O - https://apt.corretto.aws/corretto.key | gpg --dearmor --yes -o /usr/share/keyrings/corretto-keyring.gpg \
				|| die "Could not import the Corretto key"
			echo "deb [signed-by=/usr/share/keyrings/corretto-keyring.gpg] https://apt.corretto.aws stable main" > /etc/apt/sources.list.d/corretto.list \
				|| die "Could not add the Corretto repository"
			;;
		fedora)
			rpm --import https://yum.corretto.aws/corretto.key \
				&& curl -Lo /etc/yum.repos.d/corretto.repo https://yum.corretto.aws/corretto.repo \
				|| die "Could not add the Corretto repository"
			;;
		suse)
			zypper --non-interactive addrepo https://yum.corretto.aws/corretto.repo < "$TTY" \
				&& zypper --non-interactive --gpg-auto-import-keys refresh < "$TTY" \
				|| die "Could not add the Corretto repository"
			;;
	esac
}

# Fallback for unknown distributions, see https://docs.aws.amazon.com/corretto/latest/corretto-25-ug/downloads-list.html
function install_corretto_tarball() {
	local cpu name dir tmp checksum
	case "$(uname -m)" in
		x86_64) cpu=x64 ;;
		aarch64) cpu=aarch64 ;;
		*) die "There is no Corretto build for $(uname -m), please install Java $REQUIRED_JAVA_VERSION manually." ;;
	esac
	name="amazon-corretto-$REQUIRED_JAVA_VERSION-$cpu-linux-jdk.tar.gz"
	dir="/usr/lib/jvm/java-$REQUIRED_JAVA_VERSION-amazon-corretto"
	[[ ! -e "$dir" ]] \
		|| die "$dir already exists, please check your Java installation manually."

	tmp=$(mktemp -d) \
		|| die "Could not create temporary directory"
	curl -fL -o "$tmp/$name" "https://corretto.aws/downloads/latest/$name" \
		|| die "Could not download $name"
	checksum=$(curl -fsSL "https://corretto.aws/downloads/latest_sha256/$name") \
		|| die "Could not download the checksum of $name"
	echo "$checksum  $tmp/$name" | sha256sum -c --quiet \
		|| die "Checksum mismatch for $name (a new release may have been published meanwhile, try again)"

	mkdir -p "$dir" \
		&& tar -xzf "$tmp/$name" -C "$dir" --strip-components=1 \
		|| die "Could not extract $name to $dir"
	rm -rf "$tmp"
	# /usr/local/bin is part of the default PATH of systemd services
	ln -sf "$dir/bin/java" /usr/local/bin/java \
		|| die "Could not link java to /usr/local/bin/java"
}

# rdiff-backup is only available in the AUR, which must not be built as root
function install_aur_packages() {
	local helper user
	for helper in "${AUR_HELPERS[@]}"; do
		type "$helper" &>/dev/null && break
		helper=""
	done
	[[ -n "$helper" ]] \
		|| die "Installing $* requires an AUR helper (e.g. ${AUR_HELPERS[*]}). Install one or install $* manually."
	user="${SUDO_USER-}"
	[[ -n "$user" && "$user" != root ]] \
		|| die "AUR packages cannot be built as root. Run the installer via sudo from a regular user, or install $* manually."
	runuser -u "$user" -- "$helper" -S --needed "$@" < "$TTY" \
		|| die "Could not install $* with $helper"
}

mapfile -t missing < <(missing_tools)
if [[ ${#missing[@]} -gt 0 ]]; then
	for i in "${missing[@]}"; do
		echo "[1;31mmissing: [1;33m$i[m" >&2
	done

	family=$(os_family)
	[[ $EUID == 0 ]] \
		|| die "Must be root to install the missing tools."
	if [[ -z "$family" ]]; then
		[[ "${missing[*]}" == java ]] \
			|| die "Unknown distribution, please install the missing tools first."
		ask "Unknown distribution. Install Java $REQUIRED_JAVA_VERSION from the generic Amazon Corretto tarball?" \
			|| die "Please install Java $REQUIRED_JAVA_VERSION first."
		install_corretto_tarball
	else
		packages=()
		for i in "${missing[@]}"; do
			read -ra pkgs <<< "$(package_name "$family" "$i")"
			packages+=("${pkgs[@]}")
		done
		installs_java=0
		[[ " ${missing[*]} " == *" java "* ]] && installs_java=1
		if [[ "$installs_java" == 1 && "$family" != arch ]]; then
			echo "Java $REQUIRED_JAVA_VERSION will be installed from the Amazon Corretto repository, as recommended by PaperMC."
		fi
		ask "Install ${packages[*]} using the $family package manager?" \
			|| die "Please install the missing tools first."
		[[ "$installs_java" == 1 ]] && setup_corretto_repository "$family"

		case "$family" in
			arch)
				repo_packages=() aur_packages=()
				for p in "${packages[@]}"; do
					if [[ "$p" == rdiff-backup ]]; then
						aur_packages+=("$p")
					else
						repo_packages+=("$p")
					fi
				done
				if [[ ${#repo_packages[@]} -gt 0 ]]; then
					pacman -S --needed --noconfirm "${repo_packages[@]}" < "$TTY" \
						|| die "Could not install ${repo_packages[*]}"
				fi
				[[ ${#aur_packages[@]} -eq 0 ]] || install_aur_packages "${aur_packages[@]}"
				# Installing a new JRE doesn't change the default if another one is already set
				if [[ "$installs_java" == 1 ]]; then
					archlinux-java set "java-$REQUIRED_JAVA_VERSION-openjdk" \
						|| die "Could not set java-$REQUIRED_JAVA_VERSION-openjdk as default java"
				fi
				;;
			debian)
				apt-get update < "$TTY" && apt-get install -y "${packages[@]}" < "$TTY" \
					|| die "Could not install ${packages[*]}"
				;;
			fedora)
				dnf install -y "${packages[@]}" < "$TTY" \
					|| die "Could not install ${packages[*]}"
				;;
			suse)
				zypper --non-interactive install "${packages[@]}" < "$TTY" \
					|| die "Could not install ${packages[*]}"
				;;
		esac
	fi

	mapfile -t missing < <(missing_tools)
	[[ ${#missing[@]} -eq 0 ]] \
		|| die "Still missing after installation: ${missing[*]}"
fi


################################################################
# Ensure memory requirements are met and we have root access

total_ram_gibi=$(free -g | grep -oP '\d+' | head -n1)
if [[ $total_ram_gibi -le 4 ]]; then
	echo "[31mYour system has [33m${total_ram_gibi}GiB[31m of RAM, which probably is not enough to run minecraft"
	echo "without issues. The recommended minimum amount is _at least_ [33m12GiB[31m.[m"
	ask "Continue anyway?" || die "Installation aborted."
	echo
elif [[ $total_ram_gibi -lt 12 ]]; then
	echo "[31mYour system has [33m${total_ram_gibi}GiB[31m of RAM, which less than the recommended amount of"
	echo "_at least_ [33m12GiB[31m. This will hurt the server performance significantly.[m"
	ask "Continue anyway?" || die "Installation aborted."
	echo
fi

[[ $EUID == 0 ]] || die "Must be root for system-wide installation."


################################################################
# Ensure EULA is accepted

status "Agree to Mojang EULA"
echo "You have to agree to Mojang's EULA to use the server software."
echo "It is available here: https://account.mojang.com/documents/minecraft_eula"
ask "Do you agree to the EULA?" \
	|| die "Installation aborted. EULA must be accepted to continue."


################################################################
# Create minecraft user if necessary

if ! getent passwd minecraft &>/dev/null; then
	status "Creating minecraft user"
	useradd --system --home-dir /var/lib/minecraft --no-create-home minecraft \
		|| die "Could not create user 'minecraft'"
fi

mkdir -p /var/lib/minecraft
chmod 700 /var/lib/minecraft
chown minecraft: /var/lib/minecraft


################################################################
# Setup repository

if [[ -e /var/lib/minecraft/deploy ]]; then
	echo "[33mThe deploy directory /var/lib/minecraft/deploy already exists."
	echo "You can still run the installer again, but it may overwrite some"
	echo "configuration files if you edited them in the meantime.[m"
	ask "Are you sure you want to continue?" \
		|| die "Installation aborted."
fi

cd /var/lib/minecraft \
	|| die "Could not change into /var/lib/minecraft"

# Can be overridden to test a fork or a development branch, e.g.
# curl -sL <url of bootstrap> | sudo env MINECRAFT_SERVER_BRANCH=development bash
REPO_URL="${MINECRAFT_SERVER_REPO:-https://github.com/oddlama/minecraft-server}"
REPO_BRANCH="${MINECRAFT_SERVER_BRANCH:-main}"

# $1 = message
function die_with_local_changes_hint() {
	local changes
	changes=$(runuser -u minecraft -- git -C deploy status --porcelain --untracked-files=no 2>/dev/null)
	if [[ -n "$changes" ]]; then
		echo "The deploy directory contains local changes, which may conflict with the update:" >&2
		echo "$changes" >&2
		echo "Save them with the following command, then run the installer again:" >&2
		echo >&2
		echo "    sudo runuser -u minecraft -- git -C /var/lib/minecraft/deploy stash push -m \"before installer update\"" >&2
		echo >&2
		echo "You can restore them later with 'git stash pop' (run as the minecraft user)." >&2
	fi
	die "$1"
}

if [[ -e deploy ]]; then
	status "Updating deploy repository"
	if [[ -n "${MINECRAFT_SERVER_REPO-}" ]]; then
		runuser -u minecraft -- git -C deploy remote set-url origin "$REPO_URL" \
			|| die "Could not set repository url to $REPO_URL"
	fi
	if [[ -n "${MINECRAFT_SERVER_BRANCH-}" ]]; then
		runuser -u minecraft -- git -C deploy fetch origin "$REPO_BRANCH" \
			&& runuser -u minecraft -- git -C deploy switch "$REPO_BRANCH" \
			|| die_with_local_changes_hint "Could not switch to branch $REPO_BRANCH"
	fi
	runuser -u minecraft -- git -C deploy pull \
		|| die_with_local_changes_hint "Could not pull repository"
else
	status "Cloning deploy repository ($REPO_URL, branch $REPO_BRANCH)"
	runuser -u minecraft -- git clone --branch "$REPO_BRANCH" "$REPO_URL" deploy \
		|| die "Could not clone repository"
fi

cd deploy \
	|| die "Could not change into deploy directory"

status "Configuring server"
install_file <(echo "eula=true") server/eula.txt minecraft: 600

for d in $(find contrib/default_config -type d -printf '%P\n'); do
	mkdir -p -m700 "$d" || die "Could not create directory '$d'"
	chown minecraft: "$d" || die "Could not chown directory '$d'"
done

for f in $(find contrib/default_config -type f -printf '%P\n'); do
	install_file contrib/default_config/"$f" "$f" minecraft: 600
done

VELOCITYSECRET=$(openssl rand -base64 16) \
	|| die "Could not generate velocity secret"
install_file <(echo -n "$VELOCITYSECRET") proxy/forwarding.secret minecraft: 600
sed -i 's|{{VELOCITYSECRET}}|'"$VELOCITYSECRET"'|' server/config/paper-global.yml \
	|| die "Could not insert velocity secret in paper-global.yml"

# Floodgate on the proxy and the server must share the same AES key
FLOODGATEKEY=$(mktemp) \
	|| die "Could not create temporary file for floodgate key"
openssl rand -out "$FLOODGATEKEY" 16 \
	|| die "Could not generate floodgate key"
for d in proxy/plugins/floodgate server/plugins/floodgate; do
	mkdir -p -m700 "$d" || die "Could not create directory '$d'"
	chown minecraft: "$d" "$(dirname "$d")" || die "Could not chown directory '$d'"
	install_file "$FLOODGATEKEY" "$d/key.pem" minecraft: 600
done
rm -f "$FLOODGATEKEY"

FLOODGATEMETRICSUUID=$(cat /proc/sys/kernel/random/uuid) \
	|| die "Could not generate floodgate metrics uuid"
sed -i 's|{{FLOODGATEMETRICSUUID}}|'"$FLOODGATEMETRICSUUID"'|' proxy/plugins/floodgate/config.yml \
	|| die "Could not insert metrics uuid in floodgate config.yml"

echo "Depending on your player base, you might want to allow certain gamplay"
echo "exploits on your server. These are fixed by default in PaperMC, but would"
echo "allow your players to build certain vanilla machines (TNT blast chambers,"
echo "bedrock removal, ...). My personal recommendation is to answer with yes"
echo "to all of these questions."
echo

if ask "Allow headless pistons and bedrock breaking?"; then
	sed -i 's|allow-headless-pistons: false|allow-headless-pistons: true|' server/config/paper-global.yml \
		|| die "Could not replace allow-headless-pistons config"
	sed -i 's|allow-permanent-block-break-exploits: false|allow-permanent-block-break-exploits: true|' server/config/paper-global.yml \
		|| die "Could not replace allow-permanent-block-break-exploits config"
fi

if ask "Allow piston TNT duping?"; then
	sed -i 's|allow-piston-duplication: false|allow-piston-duplication: true|' server/config/paper-global.yml \
		|| die "Could not replace allow-piston-duplication config"
fi

if ask "Enable Anti-XRAY?"; then
	sed -i 's|false # ANTI_XRAY|true|' server/config/paper-world-defaults.yml \
		|| die "Could not replace ANTI_XRAY config"
else
	sed -i 's|false # ANTI_XRAY|false|' server/config/paper-world-defaults.yml \
		|| die "Could not replace ANTI_XRAY config"
fi

if ask "Replenish loot in loot chests after 1-2 realtime days?"; then
	sed -i 's|auto-replenish: false|auto-replenish: true|' server/config/paper-world-defaults.yml \
		|| die "Could not replace auto-replenish config"
fi

if ask "Disable hopper item move event to reduce lag?"; then
	sed -i 's|disable-move-event: false|disable-move-event: true|' server/config/paper-world-defaults.yml \
		|| die "Could not replace disable-move-event config"
fi

if ask "Increase view-distance to 15 chunks?"; then
	sed -i 's|view-distance=10|view-distance=15|' server/server.properties \
		|| die "Could not replace view-distance config"
fi

echo
runuser -u minecraft -- ./update.sh < "$TTY" \
	|| die "Could not update server files"


################################################################
# Install systemd services

status "Installing service files"
./contrib/install.sh < "$TTY" \
	|| die "Error while installing service files"


################################################################
# Optional domain for Bedrock players

status "Bedrock domain"
echo "Bedrock players can always join via the address that Geyser registers with"
echo "Warden (shown in the proxy log). If you have a domain (e.g. a DDNS name) pointing"
echo "to this server, players can also connect with it. This requires Caddy to obtain"
echo "a certificate, and TCP ports 80 and 19132 must be exposed to the internet."
echo

while true; do
	flush_stdin
	read -r -p "Domain for Bedrock players (leave empty to skip): " BEDROCK_DOMAIN < "$TTY" \
		|| die "Error in read"
	BEDROCK_DOMAIN="${BEDROCK_DOMAIN,,}"
	[[ -z "$BEDROCK_DOMAIN" || "$BEDROCK_DOMAIN" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]] && break
	echo "Invalid domain name '$BEDROCK_DOMAIN'"
done

C_HL=$'\e[35m' C_CMD=$'\e[1;32m' C_RESET=$'\e[m'
bedrock_domain_message=""
if [[ -n "$BEDROCK_DOMAIN" ]]; then
	install_caddyfile=1
	if [[ -e /etc/caddy/Caddyfile ]] && ! grep -q "^$BEDROCK_DOMAIN:19132 {" /etc/caddy/Caddyfile; then
		echo "/etc/caddy/Caddyfile already exists and will be replaced."
		ask "Replace /etc/caddy/Caddyfile?" || install_caddyfile=0
	fi
	if [[ "$install_caddyfile" == 1 ]]; then
		mkdir -p /etc/caddy \
			|| die "Could not create /etc/caddy"
		install_file <(sed 's|play\.example\.com|'"$BEDROCK_DOMAIN"'|' contrib/caddy/Caddyfile) /etc/caddy/Caddyfile root: 644
	fi
	bedrock_domain_message="
Bedrock players can connect via ${C_HL}${BEDROCK_DOMAIN}${C_RESET} on port ${C_HL}19132${C_RESET}. Make sure that TCP
ports ${C_HL}80${C_RESET} and ${C_HL}19132${C_RESET} are exposed to the internet as well.
"
fi


################################################################
# Open ports in the host firewall

FIREWALL_PORTS=(25565/tcp 25566/tcp 8100/tcp 19132/udp)
[[ -n "$BEDROCK_DOMAIN" ]] && FIREWALL_PORTS+=(80/tcp 19132/tcp)

if systemctl is-active --quiet firewalld && type firewall-cmd &>/dev/null; then
	# Use the zone of the interface with the default route, it may differ from the default zone
	iface=$(ip route show default | awk '{ print $5; exit }')
	zone=$(firewall-cmd --get-zone-of-interface="$iface" 2>/dev/null) \
		|| zone=$(firewall-cmd --get-default-zone) \
		|| die "Could not determine firewalld zone"
	status "Detected firewalld (zone $zone)"
	if ask "Open ports ${FIREWALL_PORTS[*]} in firewalld zone $zone?"; then
		for p in "${FIREWALL_PORTS[@]}"; do
			firewall-cmd --permanent --zone="$zone" --add-port="$p" >/dev/null \
				|| die "Could not open port $p in firewalld"
		done
		firewall-cmd --reload >/dev/null \
			|| die "Could not reload firewalld"
	fi
elif type ufw &>/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
	status "Detected ufw"
	if ask "Open ports ${FIREWALL_PORTS[*]} in ufw?"; then
		for p in "${FIREWALL_PORTS[@]}"; do
			ufw allow "$p" >/dev/null \
				|| die "Could not open port $p in ufw"
		done
	fi
fi

# Caddy needs the firewall ports to obtain its certificate, so start it afterwards
if [[ -n "$BEDROCK_DOMAIN" ]]; then
	if type caddy &>/dev/null; then
		if ask "Enable and (re)start caddy now?"; then
			systemctl enable caddy < "$TTY" \
				&& systemctl restart caddy < "$TTY" \
				|| die "Error while starting caddy"
		fi
	else
		bedrock_domain_message+="
Caddy is not installed. Install it (${C_HL}https://caddyserver.com/docs/install${C_RESET}) and run:

${C_CMD}    systemctl enable --now caddy${C_RESET}
"
	fi
fi


################################################################
# Enable and start services

status "Starting services ..."
echo "[33mSystem services for the proxy and server will now be enabled and started."
echo "If you want to adjust any proxy related configuration, you may want to start"
echo "them manually later.[m"
echo

# Geyser registers with Warden shortly after the proxy started (signaling mode nxs or hybrid)
function wait_for_warden_address() {
	local i address
	grep -qE '^\s*mode: (nxs|hybrid)\s*$' proxy/plugins/Geyser-Velocity/config.yml || return 0
	echo "Waiting for Geyser to register with Warden ..." >&2
	for (( i = 0; i < 90; ++i )); do
		# The provider state persists across restarts, the log line only appears on startup
		address=$(jq -r '.registration.publicAddress // empty' proxy/plugins/Geyser-Velocity/nethernet/provider-state/provider-state.json 2>/dev/null)
		[[ -n "$address" ]] \
			|| address=$(grep -oP 'Players can join at https://\K[^\s()]+' proxy/logs/latest.log 2>/dev/null | tail -n1)
		address="${address#*://}"
		address="${address%%/*}"
		[[ -n "$address" ]] && { echo "${address%.}"; return 0; }
		sleep 1
	done
	echo "Geyser did not register with Warden yet, check the proxy log later." >&2
}

postponed_service_message=""
warden_message=""
if ask "Enable and start system services now?"; then
	systemctl enable --now minecraft-server minecraft-proxy < "$TTY" \
		|| die "Error while enabling services"
	warden_address=$(wait_for_warden_address)
	if [[ -n "$warden_address" ]]; then
		warden_message="
Bedrock players can connect via ${C_HL}${warden_address}${C_RESET}. This address stays the same as
long as you keep proxy/plugins/Geyser-Velocity/nethernet/. The proxy log also contains
a link to claim it in the Warden panel, keep that link private.
"
	fi
else
	postponed_service_message="
You have postponed enabling the system services. Make sure to execute the
following command when you are ready to start the server:

[1;32m    systemctl enable --now minecraft-server minecraft-proxy[m
"
fi


################################################################
# Success message

cat <<EOF
[1m================================================================================[m
                            [1;32mInstallation successful![m
[1m================================================================================[m
The server and proxy have been installed successfully! The PaperMC minecraft
server will be started when a player connects via the proxy. Be aware that the
first start may take a while due to world generation.

Please make sure that TCP port [35m25565[m (server), [35m25566[m (multiplex 1), [35m8100[m
(bluemap webserver) and UDP port [35m19132[m (bedrock) are exposed to the internet via
a port-foward or similar mechanism. If you want to change your server configuration,
please do so now.
$warden_message$bedrock_domain_message$postponed_service_message
For more information, visit [35mhttps://github.com/oddlama/minecraft-server[m
[1m================================================================================[m
EOF
